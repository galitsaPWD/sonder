rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Anyone can see the stars
      allow read: if true;
      
      // Only authenticated users can post to the void
      // They MUST match their own userId to the authenticated UID
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.createdAt == request.time;
      
      // Messages are immutable
      allow update: if false;
      
      // Security: Only the owner can delete their own stars from the sky
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    match /reports/{reportId} {
      // Reports require an authenticated identity
      allow create: if request.auth != null
                    && request.resource.data.reportedBy == request.auth.uid;
      allow read: if false; // Only admin can read reports
    }
  }
}
